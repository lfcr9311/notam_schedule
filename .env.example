# Credenciais da API AISWEB (DECEA) - solicite em https://aisweb.decea.mil.br/?i=publicacoes&p=api
AISWEB_API_KEY=
AISWEB_API_PASS=
# Opcional
# AISWEB_BASE_URL=https://aisweb.decea.mil.br/api/

# API (notam-schedule-api / docker compose)
# Chave que os outros sistemas (ex.: notam-tw) mandam no cabeçalho X-API-Key. Gere com: openssl rand -hex 24
NOTAM_API_KEY=
# Minutos de cache das respostas da AISWEB (padrão 60)
# NOTAM_CACHE_MIN=60
