# Credenciais da API AISWEB (DECEA) - solicite em https://aisweb.decea.mil.br/?i=publicacoes&p=api
AISWEB_API_KEY=
AISWEB_API_PASS=
# Opcional
# AISWEB_BASE_URL=https://aisweb.decea.mil.br/api/

# API (notam-schedule-api / docker compose)
# Chave que os outros sistemas (ex.: notam-tw) mandam no cabeçalho X-API-Key. Gere com: openssl rand -hex 24
NOTAM_API_KEY=
# Minutos de cache das respostas da AISWEB (padrão 60)
# NOTAM_CACHE_MIN=60

# FAA NMS-API: NOTAMs fora do Brasil (KEY/SECRET da planilha do cadastro na FAA, notams@faa.gov).
# Sem estas duas, aeroportos estrangeiros ficam "sem fonte de NOTAM". Use as URLs do mesmo ambiente das credenciais.
FAA_NMS_CLIENT_ID=
FAA_NMS_CLIENT_SECRET=
# Padrão: produção. Pré-produção: https://api-staging.cgifederal-aim.com/nmsapi e .../v1/auth/token
# FAA_NMS_API_URL=https://api-nms.aim.faa.gov/nmsapi
# FAA_NMS_AUTH_URL=https://api-nms.aim.faa.gov/v1/auth/token

# Resumo de NOTAMs para os analistas (RSS em /web/alertas.rss, lido pelo Power Automate)
# NOTAM_DIGEST=off                      desliga o agendador
# NOTAM_DIGEST_TIMES=09:00,16:00        horários (fuso NOTAM_DIGEST_TZ, padrão America/Sao_Paulo)
# NOTAM_ALERT_AIRPORTS=SBSV,SBBE        sobrepõe data/reference/alert_airports.txt
# NOTAM_PUBLIC_URL=http://host/notam/   endereço público, para os links do e-mail
# NOTAM_DIGEST_MAX_KB=500              acima disso o e-mail leva só as restrições de pista (o resto no link)

# Banco dos aeroportos monitorados, NOTAMs e marcações de "lido" (aba "NOTAMs a tratar").
# PostgreSQL na AWS; sem esta linha usa SQLite em data/notams.db.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/notams
