{
  "openapi": "3.1.0",
  "info": {
    "title": "NOTAM Schedule API",
    "description": "NOTAMs de pista (AISWEB/DECEA): fechamentos por aeroporto e checagem de voos.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Health",
        "description": "Liveness check. Does not call the AISWEB.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/notams": {
      "get": {
        "tags": [
          "notams"
        ],
        "summary": "Notams",
        "description": "Runway NOTAMs active in the window, per airport, with closure type, periods and confidence.\n\nAirports outside DECEA coverage or whose query failed come back with status out_of_coverage/error:\nthat means there is NO DATA for them, not that they have no restriction.",
        "operationId": "notams_api_notams_get",
        "parameters": [
          {
            "name": "icao",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "One or more ICAO codes (repeat the parameter or use commas)",
              "examples": [
                "SBSV,SBBE"
              ],
              "title": "Icao"
            },
            "description": "One or more ICAO codes (repeat the parameter or use commas)"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Window start (UTC). Default: now",
              "title": "From"
            },
            "description": "Window start (UTC). Default: now"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Window end (UTC). Default: start + 15 days",
              "title": "To"
            },
            "description": "Window end (UTC). Default: start + 15 days"
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: RUNWAY_CLOSED,AERODROME_CLOSED; 'all' = every category",
              "title": "Categories"
            },
            "description": "Default: RUNWAY_CLOSED,AERODROME_CLOSED; 'all' = every category"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required when the server sets NOTAM_API_KEY",
              "title": "X-Api-Key"
            },
            "description": "Required when the server sets NOTAM_API_KEY"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotamsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runway-check": {
      "post": {
        "tags": [
          "notams"
        ],
        "summary": "Runway Check",
        "description": "For each flight leg, the closures that apply to that operation within ±margin of its time.\n\nCombines every closure at the airport: `no_runway` is true when, at some moment of the window, all\nrunways published in ROTAER are closed (then `severity` is CRITICAL even if each NOTAM alone is not).\nA landing-only closure does not restrict departures, and vice versa.",
        "operationId": "runway_check_api_runway_check_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required when the server sets NOTAM_API_KEY",
              "title": "X-Api-Key"
            },
            "description": "Required when the server sets NOTAM_API_KEY"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunwayCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunwayCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/web/notams": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Notams",
        "description": "Same as GET /api/notams, without key (used by the page).",
        "operationId": "notams_web_notams_get",
        "parameters": [
          {
            "name": "icao",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "Icao"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categories"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotamsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/web/check": {
      "post": {
        "tags": [
          "web"
        ],
        "summary": "Check",
        "description": "Same as POST /api/runway-check, limited to a few legs (the page checks one moment at a time).",
        "operationId": "check_web_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunwayCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunwayCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/web/schedule": {
      "post": {
        "tags": [
          "web"
        ],
        "summary": "Schedule",
        "description": "Full schedule analysis, like the command line: Excel/CSV to download and the run kept in the history.",
        "operationId": "schedule_web_schedule_post",
        "parameters": [
          {
            "name": "margin_before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 360,
              "minimum": 0,
              "default": 60,
              "title": "Margin Before"
            }
          },
          {
            "name": "margin_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 360,
              "minimum": 0,
              "default": 60,
              "title": "Margin After"
            }
          },
          {
            "name": "categories",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Categories"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First flight date (default: all)",
              "title": "Date From"
            },
            "description": "First flight date (default: all)"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last flight date (default: all)",
              "title": "Date To"
            },
            "description": "Last flight date (default: all)"
          },
          {
            "name": "x-filename",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "malha.xlsx",
              "title": "X-Filename"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/web/reports/{run_id}.{ext}": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Report",
        "description": "Excel or CSV of an analysis sent through the page (the latest ones are kept).",
        "operationId": "report_web_reports__run_id___ext__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          },
          {
            "name": "ext",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ext"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/web/changes": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Changes",
        "description": "What changed in a run compared with the one before it.",
        "operationId": "changes_web_changes_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: the latest run",
              "title": "Run Id"
            },
            "description": "Default: the latest run"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AirportNotams": {
        "properties": {
          "icao": {
            "type": "string",
            "pattern": "^[A-Z]{4}$",
            "title": "Icao"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA time zone of the airport, for local times",
            "examples": [
              "America/Bahia"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "out_of_coverage"
            ],
            "title": "Status",
            "description": "error/out_of_coverage mean NO DATA, never 'no restriction'"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "runways": {
            "items": {
              "$ref": "#/components/schemas/Runway"
            },
            "type": "array",
            "title": "Runways",
            "description": "Runways published in ROTAER"
          },
          "notams": {
            "items": {
              "$ref": "#/components/schemas/RunwayNotam"
            },
            "type": "array",
            "title": "Notams"
          }
        },
        "type": "object",
        "required": [
          "icao",
          "status"
        ],
        "title": "AirportNotams"
      },
      "ChangeCounts": {
        "properties": {
          "new": {
            "type": "integer",
            "title": "New",
            "default": 0
          },
          "severity_changed": {
            "type": "integer",
            "title": "Severity Changed",
            "default": 0
          },
          "window_changed": {
            "type": "integer",
            "title": "Window Changed",
            "default": 0
          },
          "ended": {
            "type": "integer",
            "title": "Ended",
            "default": 0
          }
        },
        "type": "object",
        "title": "ChangeCounts"
      },
      "ChangeRow": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "NOVO",
              "SEVERIDADE MUDOU",
              "JANELA MUDOU",
              "ENCERRADO"
            ],
            "title": "Kind"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "flight": {
            "type": "string",
            "title": "Flight"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "operation": {
            "type": "string",
            "enum": [
              "departure",
              "arrival"
            ],
            "title": "Operation"
          },
          "airport": {
            "type": "string",
            "title": "Airport"
          },
          "notam": {
            "type": "string",
            "title": "Notam"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "severity_before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity Before"
          },
          "severity_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity After"
          },
          "window_before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Period"
              },
              {
                "type": "null"
              }
            ]
          },
          "window_after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Period"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "kind",
          "date",
          "flight",
          "origin",
          "destination",
          "operation",
          "airport",
          "notam",
          "category"
        ],
        "title": "ChangeRow"
      },
      "ChangesResponse": {
        "properties": {
          "run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Run whose changes are shown (default: the latest)"
          },
          "previous": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Run it is compared with; null = first run, nothing to compare"
          },
          "counts": {
            "$ref": "#/components/schemas/ChangeCounts"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ChangeRow"
            },
            "type": "array",
            "title": "Changes"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunInfo"
            },
            "type": "array",
            "title": "Runs",
            "description": "Most recent runs, to pick another one"
          }
        },
        "type": "object",
        "required": [
          "counts",
          "changes",
          "runs"
        ],
        "title": "ChangesResponse"
      },
      "Closure": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "total",
              "conditional"
            ],
            "title": "Type",
            "description": "conditional = operations may be authorised with prior coordination / PPR"
          },
          "operations": {
            "type": "string",
            "enum": [
              "both",
              "landing",
              "takeoff"
            ],
            "title": "Operations",
            "description": "Operations the closure applies to"
          },
          "exception": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception",
            "description": "The EXC clause of the NOTAM, e.g. 'INT RWY 03/21'"
          }
        },
        "type": "object",
        "required": [
          "type",
          "operations"
        ],
        "title": "Closure"
      },
      "Confidence": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "ALTA",
              "MÉDIA",
              "BAIXA"
            ],
            "title": "Level"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "description": "What lowered (or supports) the score, in Portuguese"
          }
        },
        "type": "object",
        "required": [
          "level",
          "score",
          "reasons"
        ],
        "title": "Confidence"
      },
      "DaySummary": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "flights": {
            "type": "integer",
            "title": "Flights"
          },
          "impacted": {
            "type": "integer",
            "title": "Impacted"
          },
          "critical": {
            "type": "integer",
            "title": "Critical"
          },
          "airports": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Airports"
          }
        },
        "type": "object",
        "required": [
          "date",
          "flights",
          "impacted",
          "critical",
          "airports"
        ],
        "title": "DaySummary"
      },
      "Downloads": {
        "properties": {
          "xlsx": {
            "type": "string",
            "title": "Xlsx"
          },
          "csv": {
            "type": "string",
            "title": "Csv"
          }
        },
        "type": "object",
        "required": [
          "xlsx",
          "csv"
        ],
        "title": "Downloads"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "source": {
            "type": "string",
            "enum": [
              "aisweb",
              "offline"
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "source"
        ],
        "title": "Health"
      },
      "ImpactRow": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Flight date (ISO)"
          },
          "flight": {
            "type": "string",
            "title": "Flight"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "operation": {
            "type": "string",
            "enum": [
              "departure",
              "arrival"
            ],
            "title": "Operation"
          },
          "airport": {
            "type": "string",
            "title": "Airport"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time",
            "description": "STD/STA in UTC; null = flight without time (whole day)"
          },
          "severity": {
